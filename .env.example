# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Calendar ID — default/fallback (used for "No Preference" and any doctor without a specific ID)
GOOGLE_CALENDAR_ID=primary

# Per-doctor Google Calendar IDs (override the default for each doctor)
GOOGLE_CALENDAR_ID_1=primary
GOOGLE_CALENDAR_ID_2=primary
GOOGLE_CALENDAR_ID_3=primary

# LLM provider: "openai", "openrouter", or "anthropic"
LLM_PROVIDER=openrouter

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model name
OPENAI_MODEL=gpt-4o-mini

# OpenRouter API key (required if LLM_PROVIDER=openrouter)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model name (e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4, google/gemini-flash-1.5)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Anthropic API key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model name
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Clinic operating hours (24h format)
CLINIC_OPEN_HOUR=8
CLINIC_CLOSE_HOUR=17

# Clinic timezone
CLINIC_TIMEZONE=Asia/Singapore

# Appointment duration in minutes
APPOINTMENT_DURATION_MINUTES=30

# ── Email (SMTP) ─────────────────────────────────────────────────────
# Used to send appointment confirmation emails to patients.
# Common providers:
#   Gmail    : smtp.gmail.com  port 587  TLS=true  (use App Password, not your real password)
#   Outlook  : smtp.office365.com port 587 TLS=true
#   SendGrid : smtp.sendgrid.net port 587 TLS=true  (user "apikey", password=your API key)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=brightsmile.dental@gmail.com
SMTP_USE_TLS=true